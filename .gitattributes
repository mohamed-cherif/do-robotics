# Normalize line endings: LF in the repository and in working trees, so
# contributors on Windows, macOS and Linux produce identical diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.tflite binary
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.zip binary
*.stl binary
